// Soul Rush playtest form. GENERATED by tools/docs/form_script.js from tools/docs/questionnaire.js: edit the data, not this file.
//
// How to use: go to script.google.com, click New project, delete the sample code, paste this whole file, click Run on createPlaytestForm
// and accept the permissions (it needs Forms and Sheets: it creates a form in your Drive and a spreadsheet for the answers).
// Then open View > Logs (or Execution log) to see the form's edit link and the link to send to testers.

function createPlaytestForm() {
  var form = FormApp.create("Soul Rush: playtest feedback");
  form.setDescription("Thanks for playing Soul Rush, a boss-rush action game about deflects and posture: break a boss's posture, then land the deathblow.\n\nThere are no right or wrong answers. \"This felt unfair\" or \"I did not understand this\" is exactly what I need to hear. Answer from what you felt, skip anything you like, and it takes about 10 minutes. If you are short on time, the questions marked (quick) are enough.");
  form.setConfirmationMessage("Thank you! Your answers are in. If you remember anything else later, you can fill the form in again.");
  form.setProgressBar(true);
  form.setCollectEmail(false);
  var item;

  form.addSectionHeaderItem().setTitle("About you and the build");
  form.addTextItem().setTitle("Your name or nickname (optional)");
  form.addTextItem().setTitle("Which version or build did you play? (the developer will tell you, or leave it empty)");
  item = form.addMultipleChoiceItem().setTitle("How often do you play action games with dodges or blocks (Souls-likes, Sekiro, Hades, Hollow Knight)?");
  item.setChoices([item.createChoice("Never"), item.createChoice("A little"), item.createChoice("Regularly"), item.createChoice("A lot")]);
  item = form.addMultipleChoiceItem().setTitle("Have you played a game built around deflecting or parrying (Sekiro, Nioh, Hi-Fi Rush)?");
  item.setChoices([item.createChoice("Yes"), item.createChoice("No")]);
  item = form.addMultipleChoiceItem().setTitle("What did you play with?");
  item.setChoices([item.createChoice("Keyboard"), item.createChoice("Controller"), item.createChoice("Both")]);
  item = form.addMultipleChoiceItem().setTitle("Which browser?");
  item.setChoices([item.createChoice("Chrome"), item.createChoice("Edge"), item.createChoice("Firefox"), item.createChoice("Safari")]);
  item.showOtherOption(true);
  item = form.addMultipleChoiceItem().setTitle("How long did you play?");
  item.setChoices([item.createChoice("Under 15 minutes"), item.createChoice("15 to 30 minutes"), item.createChoice("30 to 60 minutes"), item.createChoice("Over an hour")]);
  item = form.addCheckboxItem().setTitle("Which fights did you reach?");
  item.setChoices([item.createChoice("The tutorial"), item.createChoice("Samurai phase 1"), item.createChoice("Samurai phase 2"), item.createChoice("Samurai phase 3"), item.createChoice("Leaf Ranger"), item.createChoice("Gunslinger"), item.createChoice("I beat at least one boss")]);

  form.addPageBreakItem().setTitle("First impression and the tutorial");
  form.addScaleItem().setTitle("After the tutorial, did you know what to do in the first fight?").setBounds(1, 5).setLabels("No idea", "Completely");
  item = form.addCheckboxItem().setTitle("Which of these did the tutorial teach clearly?");
  item.setChoices([item.createChoice("Moving and rolling"), item.createChoice("Attacking"), item.createChoice("Deflecting"), item.createChoice("The posture bar"), item.createChoice("The deathblow"), item.createChoice("Lives and the curse")]);
  item = form.addCheckboxItem().setTitle("Which of these was still unclear after the tutorial?");
  item.setChoices([item.createChoice("Moving and rolling"), item.createChoice("Attacking"), item.createChoice("Deflecting"), item.createChoice("The posture bar"), item.createChoice("The deathblow"), item.createChoice("Lives and the curse")]);
  item = form.addMultipleChoiceItem().setTitle("Was the tutorial...");
  item.setChoices([item.createChoice("Too long"), item.createChoice("About right"), item.createChoice("Too short")]);
  form.addParagraphTextItem().setTitle("Did any prompt or instruction confuse you? Which one?");

  form.addPageBreakItem().setTitle("Controls and mechanics").setHelpText("Rate how each felt. 1 = bad, 5 = great.");
  form.addGridItem().setTitle("How did each of these feel?").setHelpText("1 = bad, 5 = great").setRows(["Movement (walking and running)","Attack (the sword combo)","Roll (the dodge and its invulnerability)","Deflect (raising the sword just as a hit lands)","Lunge (Q, the stamina-costing dash attack)","Deathblow (F on a posture-broken boss)"]).setColumns(["1","2","3","4","5"]);
  form.addParagraphTextItem().setTitle("For anything you rated 1 or 2: what was wrong with it?");
  item = form.addMultipleChoiceItem().setTitle("Stamina: attacks, rolls and lunges all cost stamina. Which is closest?");
  item.setChoices([item.createChoice("I almost never ran out"), item.createChoice("I sometimes ran out and it felt right"), item.createChoice("I ran out too often and it felt unfair"), item.createChoice("I did not notice stamina")]);
  item = form.addMultipleChoiceItem().setTitle("Directional deflect: a deflect only works if you face the attack. How did that feel?");
  item.setChoices([item.createChoice("Natural"), item.createChoice("Fine once I got used to it"), item.createChoice("Confusing"), item.createChoice("Frustrating")]);
  item = form.addMultipleChoiceItem().setTitle("The deflect timing window is short. Was it...");
  item.setChoices([item.createChoice("Too generous"), item.createChoice("About right"), item.createChoice("A bit too tight"), item.createChoice("Far too tight")]);
  form.addParagraphTextItem().setTitle("Did the controls ever do something you did not intend (an attack when you wanted a roll, a deflect that did not come out)? Describe it.");
  form.addParagraphTextItem().setTitle("Is there a move or key you never used? Which one, and why?");

  form.addPageBreakItem().setTitle("Does the game feel fluid?");
  form.addScaleItem().setTitle("Overall, how responsive were the controls? (quick)").setBounds(1, 5).setLabels("Sluggish", "Immediate");
  item = form.addMultipleChoiceItem().setTitle("Was there a delay between pressing a key and the character reacting?");
  item.setChoices([item.createChoice("Never"), item.createChoice("Sometimes"), item.createChoice("Often"), item.createChoice("Always")]);
  item = form.addMultipleChoiceItem().setTitle("How was the frame rate? (quick)");
  item.setChoices([item.createChoice("Smooth throughout"), item.createChoice("Mostly smooth with some drops"), item.createChoice("Often choppy"), item.createChoice("Unplayable")]);
  item = form.addCheckboxItem().setTitle("When did it stutter?");
  item.setChoices([item.createChoice("Loading a scene"), item.createChoice("During a boss fight"), item.createChoice("On specific attacks or effects"), item.createChoice("Around the hub"), item.createChoice("It did not stutter")]);
  item = form.addMultipleChoiceItem().setTitle("Did the sounds line up with what you saw (hit, deflect, attack)? (quick)");
  item.setChoices([item.createChoice("Yes"), item.createChoice("Mostly"), item.createChoice("Sounds came late"), item.createChoice("Sounds were missing")]);
  item = form.addMultipleChoiceItem().setTitle("The hit-stop and screen shake when you hit or deflect...");
  item.setChoices([item.createChoice("Felt good"), item.createChoice("Were too much"), item.createChoice("Were too little"), item.createChoice("I did not notice")]);
  form.addParagraphTextItem().setTitle("Anything that felt stiff, floaty, slow to recover or sticky?");

  form.addPageBreakItem().setTitle("Difficulty and fairness");
  form.addScaleItem().setTitle("Overall difficulty (quick)").setBounds(1, 5).setLabels("Far too easy", "Far too hard");
  form.addScaleItem().setTitle("How fair did the game feel? (quick)").setBounds(1, 5).setLabels("It often felt cheap", "Every death was my fault");
  item = form.addMultipleChoiceItem().setTitle("When you died, was it usually...");
  item.setChoices([item.createChoice("I made a mistake and knew it"), item.createChoice("I did not understand what killed me"), item.createChoice("It felt unavoidable"), item.createChoice("A bug")]);
  form.addScaleItem().setTitle("Could you read enemy attacks before they hit? (quick)").setBounds(1, 5).setLabels("No", "Always");
  form.addParagraphTextItem().setTitle("Which attack was hardest to read? Tell us the boss and what it looked like.");
  form.addParagraphTextItem().setTitle("Did any attack feel impossible to deflect or dodge? Which?");
  item = form.addMultipleChoiceItem().setTitle("Damage: hits do real damage and also build your posture bar. Were hits...");
  item.setChoices([item.createChoice("Too weak"), item.createChoice("About right"), item.createChoice("Too punishing")]);
  item = form.addMultipleChoiceItem().setTitle("Lives and curse: each death costs max HP until you land a deathblow. It felt...");
  item.setChoices([item.createChoice("Motivating"), item.createChoice("Neutral"), item.createChoice("Too harsh"), item.createChoice("Confusing")]);
  item = form.addMultipleChoiceItem().setTitle("Rally: hitting a boss soon after being hurt gives some health back. Did you notice it?");
  item.setChoices([item.createChoice("Yes and I used it"), item.createChoice("Yes but it did not matter"), item.createChoice("No")]);
  form.addParagraphTextItem().setTitle("Did any fight feel too long? Which one, and at what point?");
  form.addParagraphTextItem().setTitle("Did any fight feel too easy? Which one?");

  form.addPageBreakItem().setTitle("Posture and the deathblow");
  form.addScaleItem().setTitle("Did you understand what the boss's posture bar does?").setBounds(1, 5).setLabels("Not at all", "Fully");
  item = form.addCheckboxItem().setTitle("How did you break a boss's posture most of the time?");
  item.setChoices([item.createChoice("Deflecting his attacks"), item.createChoice("Hitting him with the sword"), item.createChoice("Both"), item.createChoice("I could not break it")]);
  item = form.addMultipleChoiceItem().setTitle("How did breaking posture feel?");
  item.setChoices([item.createChoice("Satisfying and earned"), item.createChoice("Too easy"), item.createChoice("Too slow"), item.createChoice("Impossible to keep up")]);
  form.addParagraphTextItem().setTitle("Did you understand your own posture bar (under the arena)? When it filled, did you know why?");
  item = form.addMultipleChoiceItem().setTitle("The stun when your own posture broke (about 2 seconds)...");
  item.setChoices([item.createChoice("Was fair"), item.createChoice("Was too long"), item.createChoice("Was too short"), item.createChoice("Never happened to me")]);
  item = form.addMultipleChoiceItem().setTitle("Landing the deathblow was...");
  item.setChoices([item.createChoice("Satisfying"), item.createChoice("Too easy"), item.createChoice("Too hard to reach"), item.createChoice("I never landed one")]);

  form.addPageBreakItem().setTitle("The Samurai").setHelpText("Skip this page if you did not fight him.");
  form.addGridItem().setTitle("The Samurai overall").setHelpText("1 = 1 (bad), 5 = 5 (great)").setRows(["Fun","Fair","Readable (could I see what was coming?)"]).setColumns(["1","2","3","4","5"]);
  form.addGridItem().setTitle("Difficulty of each phase").setHelpText("1 = easy, 5 = hard").setRows(["Phase 1 (plain swings)","Phase 2 (he switches sides each attack)","Phase 3 (faster, with afterimages)"]).setColumns(["1","2","3","4","5"]);
  item = form.addMultipleChoiceItem().setTitle("The afterimages that appear after a dodge, dash strike or wall slash and attack on their own:");
  item.setChoices([item.createChoice("Cool and readable"), item.createChoice("Cool but confusing"), item.createChoice("Too many at once"), item.createChoice("I did not notice them")]);
  item = form.addMultipleChoiceItem().setTitle("In phase 3 you have to face the image, not him, to deflect its attack. Did you work that out?");
  item.setChoices([item.createChoice("Yes, right away"), item.createChoice("After a while"), item.createChoice("No")]);
  item = form.addMultipleChoiceItem().setTitle("The Samurai dodges some of your attacks. This...");
  item.setChoices([item.createChoice("Was fine, it keeps him alive"), item.createChoice("Happened too often"), item.createChoice("Happened too rarely"), item.createChoice("Made him feel untouchable")]);
  item = form.addMultipleChoiceItem().setTitle("The grab (he reaches for you and it cannot be deflected) was...");
  item.setChoices([item.createChoice("Fair"), item.createChoice("Too hard to avoid"), item.createChoice("Too easy to avoid"), item.createChoice("I never saw it")]);
  form.addScaleItem().setTitle("The red glints (eye glint before a dash, sheath glint before the wall slash): did they warn you in time?").setBounds(1, 5).setLabels("Not at all", "Always");
  form.addParagraphTextItem().setTitle("Petals, the tornado, the Judgement Cut: which was hardest, and which was your favorite?");
  form.addParagraphTextItem().setTitle("Anything in his pattern that felt random, even though his timings are meant to be fixed and learnable?");

  form.addPageBreakItem().setTitle("The Leaf Ranger").setHelpText("Skip this page if you did not fight him.");
  form.addGridItem().setTitle("The Leaf Ranger overall").setHelpText("1 = 1 (bad), 5 = 5 (great)").setRows(["Fun","Fair","Readable (could I see what was coming?)"]).setColumns(["1","2","3","4","5"]);
  form.addScaleItem().setTitle("Could you get close enough to hit him?").setBounds(1, 5).setLabels("Never", "Easily");
  item = form.addMultipleChoiceItem().setTitle("Posture on him: did it ever feel like you were making progress toward a break?");
  item.setChoices([item.createChoice("Yes, clearly"), item.createChoice("Sometimes"), item.createChoice("No, it never moved")]);
  item = form.addMultipleChoiceItem().setTitle("The sniper perch (he leaps up and fires arrows, and only a deflected laser brings him down) was...");
  item.setChoices([item.createChoice("Clear and fun"), item.createChoice("Confusing"), item.createChoice("Too hard"), item.createChoice("I never got there")]);
  item = form.addCheckboxItem().setTitle("Which of his moves were hardest?");
  item.setChoices([item.createChoice("Shots"), item.createChoice("Rain"), item.createChoice("Snares"), item.createChoice("Thorn wall"), item.createChoice("Bramble grasp"), item.createChoice("The beam"), item.createChoice("Air volley")]);

  form.addPageBreakItem().setTitle("The Gunslinger").setHelpText("Skip this page if you did not fight him.");
  form.addGridItem().setTitle("The Gunslinger overall").setHelpText("1 = 1 (bad), 5 = 5 (great)").setRows(["Fun","Fair","Readable (could I see what was coming?)"]).setColumns(["1","2","3","4","5"]);
  form.addParagraphTextItem().setTitle("Anything unfinished, unclear or unfair about this fight?");

  form.addPageBreakItem().setTitle("The hub and presentation");
  form.addScaleItem().setTitle("Was it clear where to go in the hub and how to start a fight?").setBounds(1, 5).setLabels("Not at all", "Very clear");
  item = form.addMultipleChoiceItem().setTitle("The keeper's training question (yes or no) was...");
  item.setChoices([item.createChoice("Helpful"), item.createChoice("Annoying"), item.createChoice("I did not notice it")]);
  form.addScaleItem().setTitle("How well could you read the screen in the middle of a fight?").setBounds(1, 5).setLabels("A mess", "Clear");
  form.addParagraphTextItem().setTitle("Were there effects, backgrounds or particles that were distracting or hid an attack?");
  form.addGridItem().setTitle("Audio").setHelpText("1 = bad, 5 = great").setRows(["Music","Sound effects"]).setColumns(["1","2","3","4","5"]);
  form.addParagraphTextItem().setTitle("Anything too loud, too quiet or repetitive in the audio?");
  item = form.addMultipleChoiceItem().setTitle("Did the sword clashes and deflects sound satisfying?");
  item.setChoices([item.createChoice("Yes"), item.createChoice("They were OK"), item.createChoice("No")]);
  form.addParagraphTextItem().setTitle("Could you always read your HP, stamina and posture, and the boss's HP and posture? Anything hard to see?");

  form.addPageBreakItem().setTitle("Overall");
  form.addScaleItem().setTitle("Would you keep playing this game? (quick)").setBounds(1, 5).setLabels("No", "Definitely");
  item = form.addMultipleChoiceItem().setTitle("Would you recommend it to a friend who likes challenging action games?");
  item.setChoices([item.createChoice("Yes"), item.createChoice("Maybe"), item.createChoice("No")]);
  form.addParagraphTextItem().setTitle("What was the best moment? (quick)");
  form.addParagraphTextItem().setTitle("What was the most frustrating moment? (quick)");
  form.addParagraphTextItem().setTitle("If you could change one thing, what would it be? (quick)");
  form.addParagraphTextItem().setTitle("Bugs: anything broken, stuck or glitchy? Where, and what were you doing? (Say if you can send a screenshot or a recording.)");
  form.addParagraphTextItem().setTitle("Anything else?");

  var sheet = SpreadsheetApp.create("Soul Rush: playtest feedback (answers)");
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());

  Logger.log('Edit the form here: ' + form.getEditUrl());
  Logger.log('Send testers this link: ' + form.getPublishedUrl());
  Logger.log('Answers collect in: ' + sheet.getUrl());
}
