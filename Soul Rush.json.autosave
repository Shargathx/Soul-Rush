r","IsPostureBroken","False",""]},{"type":{"value":"BooleanObjectVariable"},"parameters":["Player","IsRolling","False",""]},{"type":{"value":"Distance"},"parameters":["Player","Enemy","Player.Variable(DeathblowRange)",""]}],"actions":[{"type":{"value":"SetXY"},"parameters":["Deathblow_Prompt","=","Enemy.BoundingBoxLeft() + (Enemy.Width() / 2) - (Deathblow_Prompt.Width() / 2)","=","Enemy.BoundingBoxTop() - 55"]},{"type":{"value":"Show"},"parameters":["Deathblow_Prompt",""]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Enemy loses a life at 0 HP and is deleted on its last life."},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["Enemy","Health","<=","0"]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["Enemy","Lives","-","1"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Enemy","Health","=","Enemy.Variable(MaxHealth)"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["Enemy","Lives","<=","0"]}],"actions":[{"type":{"value":"Delete"},"parameters":["Enemy",""]}]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Enemy hitbox hits the player. Uses Enemy.AttackDamage and sets JustHitPlayer for the boss's events."},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CollisionNP"},"parameters":["EnemyHitbox","Player","","",""]},{"type":{"value":"BooleanObjectVariable"},"parameters":["Player","Iframe","False",""]},{"type":{"value":"BooleanObjectVariable"},"parameters":["Player","RespawnIframe","False",""]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","Health","-","Enemy.Variable(AttackDamage)"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","PendingRally","+","Enemy.Variable(AttackDamage)"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","MaxRally","=","Player.Variable(PendingRally)"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","Posture","+","Enemy.Variable(PostureDamage)"]},{"type":{"value":"ResetObjectTimer"},"parameters":["Player","\"PostureRegenTimer\""]},{"type":{"value":"ResetObjectTimer"},"parameters":["Player","\"RallyTimer\""]},{"type":{"value":"SetBooleanObjectVariable"},"parameters":["Enemy","JustHitPlayer","True",""]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Player loses a life: applies the curse, clears rally and posture, and starts respawn invulnerability."},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["Player","Health","<=","0"]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","Lives","-","1"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","MaxHealth","=","max(1, Player.Variable(MaxHealth) - Player.Variable(BaseMaxHealth) * Player.Variable(CursePercent) / 100)"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","Health","=","Player.Variable(MaxHealth)"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","PendingRally","=","0"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","MaxRally","=","0"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","Posture","=","0"]},{"type":{"value":"SetBooleanObjectVariable"},"parameters":["Player","IsPostureBroken","False",""]},{"type":{"value":"SetBooleanObjectVariable"},"parameters":["Player","RespawnIframe","True",""]},{"type":{"value":"ResetObjectTimer"},"parameters":["Player","\"RespawnTimer\""]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["Player","Lives","<=","0"]}],"actions":[{"type":{"value":"Delete"},"parameters":["Player",""]}]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"End respawn invulnerability after 1.5 seconds."},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanObjectVariable"},"parameters":["Player","RespawnIframe","True",""]},{"type":{"value":"CompareObjectTimer"},"parameters":["Player","\"RespawnTimer\"",">=","1.5"]}],"actions":[{"type":{"value":"SetBooleanObjectVariable"},"parameters":["Player","RespawnIframe","False",""]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Curse removal: the deathblow sets Player.DeathblowLanded. This restores max HP, refills HP, and clears rally."},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanObjectVariable"},"parameters":["Player","DeathblowLanded","True",""]}],"actions":[{"type":{"value":"SetBooleanObjectVariable"},"parameters":["Player","DeathblowLanded","False",""]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","MaxHealth","=","Player.Variable(BaseMaxHealth)"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","Health","=","Player.Variable(MaxHealth)"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","PendingRally","=","0"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Player","MaxRally","=","0"]}]}]}],"externalEventsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Player_Movement"},{"itemName":"Combat_Shared"}]},"tests":[{"description":"Bullets spawn during shooting animations and damage the player; the gunslinger dashes randomly when hit.","lastRunAt":1793968280218.0,"lastRunDurationMs":776.0,"lastRunFramesExecuted":104,"lastRunStatus":"passed","name":"Gunslinger_Bullets_And_Hit_Dash","type":"gameplay","source":["await harness.goToScene('Gunslinger');","const gotBullet = await harness.stepUntil(() => harness.getObjects('Bullet').length > 0, { maxFrames: 600 });","harness.assert(gotBullet, 'A bullet was spawned while a shooting animation plays');","const startX = harness.getObjects('Bullet')[0].x;","let movedFar = false;","await harness.stepUntil(() => {","  const bs = harness.getObjects('Bullet');","  if (bs.length > 0 && Math.abs(bs[0].x - startX) > 20) movedFar = true;","  return movedFar || bs.length === 0;","}, { maxFrames: 120 });","harness.assert(movedFar, 'Bullet travels toward the player');","const hpBefore = harness.getObjectVariable('Player', 'Health')?.value;","const damaged = await harness.stepUntil(() => {","  const hp = harness.getObjectVariable('Player', 'Health')?.value;","  return hp !== undefined && hpBefore !== undefined && hp < hpBefore;","}, { maxFrames: 900 });","harness.assert(damaged, 'Player health decreased after being hit by a bullet');","const gsX = harness.getObjects('Gunslinger_NPC')[0].x;","harness.setObjectVariable('Gunslinger_NPC', 'JustHitByPlayer', true);","await harness.stepFrames(5);","const dashed = await harness.stepUntil(() => Math.abs(harness.getObjects('Gunslinger_NPC')[0].x - gsX) > 60, { maxFrames: 120 });","harness.assert(dashed, 'Gunslinger dashed (moved > 60px) after being hit');","const anim = harness.getObjects('Gunslinger_NPC')[0].animation;","harness.assert(anim === 'dash_bwd' || anim === 'dash_fwd', 'Dash animation is dash_bwd or dash_fwd, got ' + anim);"]}],"testsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Gunslinger_Bullets_And_Hit_Dash"}]},"eventsFunctionsExtensions":[{"author":"","category":"User interface","dimension":"2D","extensionNamespace":"","fullName":"Resource bar (continuous)","gdevelopVersion":">=5.5.230","helpPath":"/objects/resource-bar","iconUrl":"data:ima